{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aletheia",
  "version": "0.1.0",
  "identifier": "io.github.ra9001.aletheia",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aletheia",
        "width": 1060,
        "height": 900,
        "minWidth": 820,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
